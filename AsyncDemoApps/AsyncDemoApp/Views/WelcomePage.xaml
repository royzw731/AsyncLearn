<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ViewModels"
    x:Class="Views.WelcomePage"
    x:DataType="vm:WelcomeViewModel"
    FlowDirection="RightToLeft"
    Title="{Binding Title}">

    <VerticalStackLayout Padding="30"
                         Spacing="20"
                         VerticalOptions="Center">

        <Label Text="ברוכים הבאים לאפליקציות להדגמת אסינכרוניות"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Button Text="אסינכרוניות / סינכרוניות"
                Command="{Binding NavigateToAsyncDemoCommand}"
                HeightRequest="50" />

        <Button Text="ניהול משימות אסינכרוניות"
                Command="{Binding NavigateToTasksCommand}"
                HeightRequest="50"
                BackgroundColor="#512BD4"
                TextColor="White" />

    </VerticalStackLayout>

</ContentPage>